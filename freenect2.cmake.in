# freenect2Config.cmake -- resolves relative to this file so the install tree
# can be moved and a consumer's CMAKE_PREFIX_PATH / -Dfreenect2_DIR is honoured.
get_filename_component(_freenect2_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

find_path(freenect2_INCLUDE_DIR
    NAMES libfreenect2/libfreenect2.hpp
    HINTS "${_freenect2_prefix}/include"
)
find_library(freenect2_LIBRARY
    NAMES freenect2
    HINTS "${_freenect2_prefix}/lib"
)
find_library(freenect2_logging_LIBRARY
    NAMES freenect2_logging
    HINTS "${_freenect2_prefix}/lib"
)

set(freenect2_INCLUDE_DIRS ${freenect2_INCLUDE_DIR})
set(freenect2_LIBRARIES ${freenect2_LIBRARY} ${freenect2_logging_LIBRARY})

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(freenect2
    REQUIRED_VARS freenect2_LIBRARY freenect2_logging_LIBRARY freenect2_INCLUDE_DIR
)

unset(_freenect2_prefix)
