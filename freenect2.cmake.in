@PACKAGE_INIT@
# freenect2Config.cmake -- a real install(EXPORT)-generated config (see the root CMakeLists' own
# comment on why: the previous hand-rolled version's find_library() calls only ever searched the
# Release lib/ directory, so every config - Debug included - silently linked the Release import
# library; that library's own embedded DLL name never matched what actually existed in
# debug/bin, and a Debug consumer's loader could never resolve it at runtime).
#
# freenect2::freenect2, freenect2::freenect2_logging, freenect2::freenect2_audio (when built with
# the audio feature) are real IMPORTED targets with correct per-config
# (IMPORTED_LOCATION_DEBUG/_RELEASE) library paths, generated by CMake itself from
# freenect2Targets.cmake below - no more hand-maintained find_library()/IMPORTED_LOCATION code to
# drift out of sync with how these targets are actually built. Consumers link these targets
# directly (freenect2::freenect2, freenect2::freenect2_audio, ...) - no freenect2_LIBRARIES /
# freenect2_INCLUDE_DIRS variable compatibility layer.

include(CMakeFindDependencyMacro)
# freenect2_logging links fmt PUBLICly (see src/logging/CMakeLists.txt) - a real vcpkg CONFIG
# package, so find_dependency() is all it needs.
find_dependency(fmt CONFIG)
# Core freenect2 links libusb::libusb-1.0 PUBLIC (see src/CMakeLists.txt) - vcpkg's libusb has no
# CMake config to find_dependency() against, so this constructs the same hand-built target its own
# build uses (see FindLibUSB1.cmake's own doc comment). Installed alongside this file.
include("${CMAKE_CURRENT_LIST_DIR}/FindLibUSB1.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/freenect2Targets.cmake")

check_required_components(freenect2)
