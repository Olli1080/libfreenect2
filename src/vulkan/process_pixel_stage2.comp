// Ported from src/opencl/opencl_depth_packet_processor.cl's
// processPixelStage2 kernel (the phase-unwrapping/dealiasing math). Notable
// translation points beyond the usual float3->vec3/select->mix ones:
//  - atan2(y, x) -> GLSL's two-argument atan(y, x), same semantics
//  - the modeMask&2 branch in the original is always taken (hardcoded
//    `true` in the OpenCL source too) -- phase_final = t11 unconditionally;
//    kept the dead t10 *= mask3 line anyway for a literal, easy-to-diff port

#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer ABuf { vec4 a_in[]; };
layout(set = 0, binding = 1) readonly buffer BBuf { vec4 b_in[]; };
layout(set = 0, binding = 2) readonly buffer XTableBuf { float x_table[]; };
layout(set = 0, binding = 3) readonly buffer ZTableBuf { float z_table[]; };
layout(set = 0, binding = 4) writeonly buffer DepthOutBuf { float depth_out[]; };
layout(set = 0, binding = 5) writeonly buffer IrSumOutBuf { float ir_sum_out[]; };

layout(push_constant) uniform PushConstants
{
  float ab_multiplier;
  float individual_ab_threshold;
  float ab_threshold;
  float ab_confidence_slope;
  float ab_confidence_offset;
  float min_dealias_confidence;
  float max_dealias_confidence;
  float phase_offset;
  float unambigious_dist;
} pc;

const float kPi = 3.14159265358979323846;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= 512u * 424u)
    return;

  vec3 a = a_in[i].xyz;
  vec3 b = b_in[i].xyz;

  vec3 phase = atan(b, a);
  phase = mix(phase, phase + 2.0 * kPi, lessThan(phase, vec3(0.0)));
  phase = mix(phase, vec3(0.0), isnan(phase));
  vec3 ir = sqrt(a * a + b * b) * pc.ab_multiplier;

  float ir_sum = ir.x + ir.y + ir.z;
  float ir_min = min(ir.x, min(ir.y, ir.z));
  float ir_max = max(ir.x, max(ir.y, ir.z));

  float phase_final = 0.0;

  if (ir_min >= pc.individual_ab_threshold && ir_sum >= pc.ab_threshold)
  {
    vec3 t = phase / (2.0 * kPi) * vec3(3.0, 15.0, 2.0);

    float t0 = t.x;
    float t1 = t.y;
    float t2 = t.z;

    float t5 = floor((t1 - t0) * 0.333333 + 0.5) * 3.0 + t0;
    float t3 = -t2 + t5;
    float t4 = t3 * 2.0;

    bool c1 = t4 >= -t4; // true if t4 positive

    float f1 = c1 ? 2.0 : -2.0;
    float f2 = c1 ? 0.5 : -0.5;
    t3 *= f2;
    t3 = (t3 - floor(t3)) * f1;

    bool c2 = 0.5 < abs(t3) && abs(t3) < 1.5;

    float t6 = c2 ? t5 + 15.0 : t5;
    float t7 = c2 ? t1 + 15.0 : t1;

    float t8 = (floor((-t2 + t6) * 0.5 + 0.5) * 2.0 + t2) * 0.5;

    t6 *= 0.333333; // = / 3
    t7 *= 0.066667; // = / 15

    float t9 = t8 + t6 + t7; // transformed phase measurements
    float t10 = t9 * 0.333333; // some avg

    t6 *= 2.0 * kPi;
    t7 *= 2.0 * kPi;
    t8 *= 2.0 * kPi;

    // some cross product
    float t8_new = t7 * 0.826977 - t8 * 0.110264;
    float t6_new = t8 * 0.551318 - t6 * 0.826977;
    float t7_new = t6 * 0.110264 - t7 * 0.551318;

    t8 = t8_new;
    t6 = t6_new;
    t7 = t7_new;

    float norm = t8 * t8 + t6 * t6 + t7 * t7;
    float mask = t9 >= 0.0 ? 1.0 : 0.0;
    t10 *= mask;

    bool slope_positive = 0.0 < pc.ab_confidence_slope;

    float ir_x = slope_positive ? ir_min : ir_max;

    ir_x = log(ir_x);
    ir_x = (ir_x * pc.ab_confidence_slope * 0.301030 + pc.ab_confidence_offset) * 3.321928;
    ir_x = exp(ir_x);
    ir_x = clamp(ir_x, pc.min_dealias_confidence, pc.max_dealias_confidence);
    ir_x *= ir_x;

    float mask2 = ir_x >= norm ? 1.0 : 0.0;

    float t11 = t10 * mask2;

    float mask3 = (pc.max_dealias_confidence * pc.max_dealias_confidence >= norm) ? 1.0 : 0.0;
    t10 *= mask3;
    phase_final = t11; // modeMask&2 always true, see file comment
  }

  float zmultiplier = z_table[i];
  float xmultiplier = x_table[i];

  phase_final = 0.0 < phase_final ? phase_final + pc.phase_offset : phase_final;

  float depth_linear = zmultiplier * phase_final;
  float max_depth = phase_final * pc.unambigious_dist * 2.0;

  bool cond1 = 0.0 < depth_linear && 0.0 < max_depth;

  xmultiplier = (xmultiplier * 90.0) / (max_depth * max_depth * 8192.0);

  float depth_fit = depth_linear / (-depth_linear * xmultiplier + 1.0);
  depth_fit = depth_fit < 0.0 ? 0.0 : depth_fit;

  float d = cond1 ? depth_fit : depth_linear;
  depth_out[i] = d;
  ir_sum_out[i] = ir_sum;
}
