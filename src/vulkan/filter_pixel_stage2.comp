// Ported from src/opencl/opencl_depth_packet_processor.cl's
// filterPixelStage2 kernel. Restructured with early returns for the two
// outer if/else branches (min/max depth range check, then border check) --
// behaviorally identical to the original's nested if/else, just flatter.

#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer DepthBuf { float depth_in[]; };
layout(set = 0, binding = 1) readonly buffer IrSumsBuf { float ir_sums[]; };
layout(set = 0, binding = 2) readonly buffer MaxEdgeTestBuf { uint max_edge_test[]; };
layout(set = 0, binding = 3) writeonly buffer FilteredBuf { float filtered[]; };

layout(push_constant) uniform PushConstants
{
  float min_depth;
  float max_depth;
  float edge_ab_avg_min_value;
  float edge_ab_std_dev_threshold;
  float edge_close_delta_threshold;
  float edge_far_delta_threshold;
  float edge_max_delta_threshold;
  float edge_avg_delta_threshold;
  float max_edge_count;
} pc;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= 512u * 424u)
    return;

  uint x = i % 512u;
  uint y = i / 512u;

  float raw_depth = depth_in[i];
  float ir_sum = ir_sums[i];
  uint edge_test = max_edge_test[i];

  if (raw_depth < pc.min_depth || raw_depth > pc.max_depth)
  {
    filtered[i] = 0.0;
    return;
  }

  if (x < 1u || y < 1u || x > 510u || y > 422u)
  {
    filtered[i] = raw_depth;
    return;
  }

  float ir_sum_acc = ir_sum;
  float squared_ir_sum_acc = ir_sum * ir_sum;
  float min_depth_v = raw_depth;
  float max_depth_v = raw_depth;

  for (int yi = -1; yi < 2; ++yi)
  {
    uint i_other = (y + uint(yi)) * 512u + x - 1u;
    for (int xi = -1; xi < 2; ++xi, ++i_other)
    {
      if (i_other == i)
        continue;

      float raw_depth_other = depth_in[i_other];
      float ir_sum_other = ir_sums[i_other];

      ir_sum_acc += ir_sum_other;
      squared_ir_sum_acc += ir_sum_other * ir_sum_other;

      if (0.0 < raw_depth_other)
      {
        min_depth_v = min(min_depth_v, raw_depth_other);
        max_depth_v = max(max_depth_v, raw_depth_other);
      }
    }
  }

  float tmp0 = sqrt(squared_ir_sum_acc * 9.0 - ir_sum_acc * ir_sum_acc) / 9.0;
  float edge_avg = max(ir_sum_acc / 9.0, pc.edge_ab_avg_min_value);
  tmp0 /= edge_avg;

  float abs_min_diff = abs(raw_depth - min_depth_v);
  float abs_max_diff = abs(raw_depth - max_depth_v);

  float avg_diff = (abs_min_diff + abs_max_diff) * 0.5;
  float max_abs_diff = max(abs_min_diff, abs_max_diff);

  bool cond0 =
      0.0 < raw_depth &&
      tmp0 >= pc.edge_ab_std_dev_threshold &&
      pc.edge_close_delta_threshold < abs_min_diff &&
      pc.edge_far_delta_threshold < abs_max_diff &&
      pc.edge_max_delta_threshold < max_abs_diff &&
      pc.edge_avg_delta_threshold < avg_diff;

  if (cond0)
  {
    filtered[i] = 0.0;
    return;
  }

  if (edge_test != 0u)
  {
    float edge_count = 0.0;
    filtered[i] = edge_count > pc.max_edge_count ? 0.0 : raw_depth;
  }
  else
  {
    filtered[i] = 0.0;
  }
}
