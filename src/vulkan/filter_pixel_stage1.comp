// Ported from src/opencl/opencl_depth_packet_processor.cl's
// filterPixelStage1 kernel. Push constants are scalars only (no vec3) --
// see process_pixel_stage1.comp's file comment for why that matters here.
// The Gaussian kernel weights come from a storage buffer instead of push
// constants: std430 storage buffers give float[] a plain 4-byte stride,
// so there's no packing ambiguity to get wrong the way there was with
// stage 1's original vec3-in-push-constants layout.

#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer ABuf { vec4 a_in[]; };
layout(set = 0, binding = 1) readonly buffer BBuf { vec4 b_in[]; };
layout(set = 0, binding = 2) readonly buffer NBuf { vec4 n_in[]; };
layout(set = 0, binding = 3) readonly buffer GaussianBuf { float gaussian[9]; };
layout(set = 0, binding = 4) writeonly buffer AOutBuf { vec4 a_out[]; };
layout(set = 0, binding = 5) writeonly buffer BOutBuf { vec4 b_out[]; };
layout(set = 0, binding = 6) writeonly buffer MaxEdgeTestBuf { uint max_edge_test[]; };

layout(push_constant) uniform PushConstants
{
  float joint_bilateral_threshold;
  float joint_bilateral_exp;
  float joint_bilateral_max_edge;
} pc;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= 512u * 424u)
    return;

  uint x = i % 512u;
  uint y = i / 512u;

  vec3 self_a = a_in[i].xyz;
  vec3 self_b = b_in[i].xyz;

  if (x < 1u || y < 1u || x > 510u || y > 422u)
  {
    a_out[i] = vec4(self_a, 0.0);
    b_out[i] = vec4(self_b, 0.0);
    max_edge_test[i] = 1u;
    return;
  }

  vec3 threshold = vec3(pc.joint_bilateral_threshold);
  vec3 joint_bilateral_exp = vec3(pc.joint_bilateral_exp);

  vec3 self_norm = n_in[i].xyz;
  vec3 self_normalized_a = self_a / self_norm;
  vec3 self_normalized_b = self_b / self_norm;

  vec3 weight_acc = vec3(0.0);
  vec3 weighted_a_acc = vec3(0.0);
  vec3 weighted_b_acc = vec3(0.0);
  vec3 dist_acc = vec3(0.0);

  bvec3 c0 = lessThan(self_norm * self_norm, threshold);
  threshold = mix(threshold, vec3(0.0), c0);
  joint_bilateral_exp = mix(joint_bilateral_exp, vec3(0.0), c0);

  int j = 0;
  for (int yi = -1; yi < 2; ++yi)
  {
    uint i_other = (y + uint(yi)) * 512u + x - 1u;
    for (int xi = -1; xi < 2; ++xi, ++j, ++i_other)
    {
      vec3 other_a = a_in[i_other].xyz;
      vec3 other_b = b_in[i_other].xyz;
      vec3 other_norm = n_in[i_other].xyz;
      vec3 other_normalized_a = other_a / other_norm;
      vec3 other_normalized_b = other_b / other_norm;

      bvec3 c1 = lessThan(other_norm * other_norm, threshold);

      vec3 dist = 0.5 * (vec3(1.0) - (self_normalized_a * other_normalized_a + self_normalized_b * other_normalized_b));
      vec3 weight = mix(gaussian[j] * exp(-1.442695 * joint_bilateral_exp * dist), vec3(0.0), c1);

      weighted_a_acc += weight * other_a;
      weighted_b_acc += weight * other_b;
      weight_acc += weight;
      dist_acc += mix(dist, vec3(0.0), c1);
    }
  }

  bvec3 c2 = lessThan(vec3(0.0), weight_acc);
  a_out[i] = vec4(mix(vec3(0.0), weighted_a_acc / weight_acc, c2), 0.0);
  b_out[i] = vec4(mix(vec3(0.0), weighted_b_acc / weight_acc, c2), 0.0);

  max_edge_test[i] = all(lessThan(dist_acc, vec3(pc.joint_bilateral_max_edge))) ? 1u : 0u;
}
